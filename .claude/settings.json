{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/board-session-start.sh",
            "timeout": 20
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/board-prompt.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(tools/board unread)",
      "Bash(tools/board whoami)",
      "Bash(tools/board read:*)",
      "Bash(tools/board wait:*)",
      "Bash(tools/board wait)",
      "Bash(bash tools/board unread)",
      "Bash(bash tools/board whoami)",
      "Bash(bash tools/board read:*)",
      "Bash(bash tools/board wait:*)",
      "Bash(bash tools/board wait)"
    ]
  }
}
