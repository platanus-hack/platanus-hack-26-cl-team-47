# Los scripts de bash deben quedar con LF aunque se clonen en Windows (core.autocrlf=true):
# con CRLF fallan en WSL, macOS y Linux.
* text=auto
*.sh text eol=lf
tools/** text eol=lf
*.ps1 text eol=crlf
*.png binary
*.jpg binary
# Datos versionados que se comparan byte a byte en los tests: siempre LF.
*.jsonl text eol=lf
demo/viz/fixtures/** text eol=lf
# El hash del modelo congelado se calcula sobre estos bytes: siempre LF.
models/** text eol=lf
results/** text eol=lf
